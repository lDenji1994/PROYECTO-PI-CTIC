spring.datasource.url=jdbc:mysql://localhost:3307/CertificadosCursosAcademicosUPB?useSSL=false&serverTimezone=America/Bogota&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=TU_CONTRASENA_AQUI

# Id de un usuario existente en la tabla de usuarios (para la bitacora)
app.auditoria.id-usuario-por-defecto=1

